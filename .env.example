# ==============================================================================
# Attendance Management System - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed. Every variable is optional -
# config.py falls back to sensible defaults for local development if a
# variable (or the whole .env file) is missing. See README.md for the full
# reference table.
# ==============================================================================

# ---- Application --------------------------------------------------------
APP_ENVIRONMENT=development
# APP_NAME=Attendance Management System
# APP_NAME_AR=نظام إدارة الحضور والانصراف
# APP_VERSION=1.0.0
# APP_ORGANIZATION_NAME=Attendance Systems

# ---- Database ------------------------------------------------------------
DB_DIALECT=sqlite
# DB_SQLITE_PATH=data/attendance.db

# Only used when DB_DIALECT=postgresql or DB_DIALECT=mysql:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_NAME=attendance_system
# DB_ECHO_SQL=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=10

# ---- Security --------------------------------------------------------------
# SECURITY_BCRYPT_ROUNDS=12
# SECURITY_SESSION_TIMEOUT_MINUTES=30
# SECURITY_MAX_LOGIN_ATTEMPTS=5
# SECURITY_LOGIN_LOCKOUT_MINUTES=15
# SECURITY_MIN_PASSWORD_LENGTH=8

# ---- UI ----------------------------------------------------------------
# UI_DEFAULT_THEME=light

# ---- Backup --------------------------------------------------------------
# BACKUP_AUTO_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14
# BACKUP_ON_STARTUP=false

# ---- Biometric Devices -----------------------------------------------------
# DEVICE_ZKTECO_PORT=4370
# DEVICE_ZKTECO_TIMEOUT=8
# DEVICE_HIKVISION_PORT=80
# DEVICE_HIKVISION_TIMEOUT=8
# DEVICE_RETRY_ATTEMPTS=3
# DEVICE_DISCOVERY_TIMEOUT=5
# DEVICE_AUTO_SYNC_ENABLED=true
# DEVICE_AUTO_SYNC_INTERVAL_MINUTES=15

# ---- Logging ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_ROTATION=10 MB
# LOG_RETENTION=30 days
