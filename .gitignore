# Runtime data generated by config.py / database.py — never committed.
data/
logs/*.log
!logs/.gitkeep

# Runtime data generated by developer_suite/config.py in local
# development (mirrors data/ and logs/ above, for the Developer Suite
# application) — never committed.
developer_suite_data/

# Local environment overrides (DB credentials, secret key, etc.)
.env

# License-signing private key — must never ship with the application or be
# committed to version control (see licensing/keys.py's docstring). Keep the
# only copy somewhere secure, outside this repository.
licensing/vendor/

# PyInstaller build output (the spec files themselves, under
# packaging/pyinstaller/, are hand-authored and must be committed — see
# the negation below).
build/
dist/
*.spec
!packaging/pyinstaller/*.spec

# Windows build venv created by packaging/build_all.bat
.venv-build/

# Windows binaries produced by a real Windows build (see BUILD_WINDOWS.md);
# only the generated documentation ships from this Linux environment.
Release/*.exe
